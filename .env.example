# Mumble AI (Murmur Flow) Environment Configuration
# Copy this file to .env and configure for your deployment environment.

PORT=3050
NODE_ENV=production

# Database Connection (Supabase PostgreSQL / Cloud Postgres)
# When DATABASE_URL is set, Mumble AI connects to PostgreSQL using connection pooling and SSL.
# When omitted, Mumble AI falls back to local SQLite at data/mumble_flow.sqlite.
# Supabase Pooler URI: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
# DB_POOL_MAX=10

# Production Security & Encryption (CRITICAL FOR MULTI-USER & PERSISTENCE)
# Generate with: openssl rand -hex 32
# JWT_SECRET: Signs session tokens; required so user sessions survive container restarts
JWT_SECRET=
# ENCRYPTION_KEY: AES-256-GCM master key to encrypt user BYOK API keys at rest in SQLite
ENCRYPTION_KEY=

# System Provider API Keys (Platform fallback when users do not provide their own keys)
# Groq API Key (STT & LLM). Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key. Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Default Engine Selection
# STT options: 'groq' | 'gemini' | 'openai' | 'local'
DEFAULT_STT_PROVIDER=groq
# LLM options: 'groq' | 'gemini' | 'openai' | 'local'
DEFAULT_LLM_PROVIDER=groq

# Zero-Edit Defaults
DEFAULT_TONE=casual
AUTO_COPY_CLIPBOARD=true

# Local Self-Hosted Whisper / Ollama Endpoints (Optional)
# LOCAL_WHISPER_URL=http://localhost:8000/v1/audio/transcriptions
# LOCAL_LLM_URL=http://localhost:11434/v1

