  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  }
