{
  "name": "mumble-flow",
  "version": "1.0.0",
  "description": "Mumble AI — Self-hosted voice dictation. Speak naturally, get cleaned text, on your computer or your own server.",
  "repository": {
    "type": "git",
    "url": "https://github.com/maaz-ahmad-63/mumble_flow.git"
  },
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
