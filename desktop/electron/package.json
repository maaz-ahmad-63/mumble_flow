{
  "name": "mumble-ai-desktop",
  "version": "1.0.0",
  "description": "Mumble AI — Native desktop voice dictation app. Speak naturally, text appears at your cursor.",
  "author": "Maaz Ahmad",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:all": "electron-builder --mac --win --publish never"
  },
  "build": {
    "appId": "com.mumbleai.desktop",
    "productName": "Mumble AI",
    "publish": {
      "provider": "github",
      "owner": "maaz-ahmad-63",
      "repo": "mumble_flow"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mumble AI needs microphone access to transcribe your speech.",
        "NSAppleEventsUsageDescription": "Mumble AI uses Accessibility to type dictated text into your active application."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "modules/**/*",
      "platform/**/*",
      "assets/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../../server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules",
          "!**/*.test.js",
          "!**/*.spec.js",
          "!**/.env*"
        ]
      },
      {
        "from": "../../client",
        "to": "client"
      },
      {
        "from": "../../package.json",
        "to": "package.json"
      }
    ]
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^10.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
